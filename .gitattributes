# Normalize line endings across platforms
*               text=auto

# Enforce LF for source and config files
*.go            text eol=lf
go.mod          text eol=lf
go.sum          text eol=lf
*.sh            text eol=lf
*.bash          text eol=lf
*.zsh           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.tpl           text eol=lf
*.tmpl          text eol=lf
*.html          text eol=lf
*.env           text eol=lf
*.example       text eol=lf
Dockerfile      text eol=lf
Makefile        text eol=lf
.editorconfig   text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf

# Binary files (no line ending conversions)
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.pdf           binary
*.ico           binary
*.zip           binary
*.gz            binary
*.tar           binary
*.tgz           binary
*.exe           binary
*.dll           binary
